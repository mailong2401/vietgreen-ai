# Copy thành .env và điền giá trị thật
POSTGRES_DB=vietgreen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_HOST_PORT=5432

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_VOLUME=qdrant_data
POSTGRES_VOLUME=postgres_data

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vietgreen_documents
EMBED_DIM=768

OLLAMA_EXTRACT_MODEL=vietgreen-ai
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=vietgreen-ai

PG_DBNAME=vietgreen_db
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_HOST=localhost
PG_PORT=5432

MAX_TEXT_CHARS_FOR_LLM=12000
CHUNK_SIZE=500
MAX_CHUNKS=200
EMBED_CONCURRENCY=4
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.5
